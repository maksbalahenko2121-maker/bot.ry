@dp.callback_query(F.data == "play_slots")

async def play_slots(callback: types.CallbackQuery):

    user_id = callback.from_user.id

    bet = 10

    if get_balance(user_id) < bet:

        await callback.answer("Недостаточно звезд! Нажми «Купить звезды».", show_alert=True)

        return

 

    update_balance(user_id, -bet)

    await callback.answer()

    msg = await callback.message.answer_dice(emoji="🎰")

    val = msg.dice.value

    await asyncio.sleep(2)

   

    if val in (1, 22, 43, 64):

        win = bet * 5

        update_balance(user_id, win)

        text = f"🔥 ДЖЕКПОТ! Выигрыш: <b>+{win} ⭐</b>!"

    else:

        text = "💨 Не повезло. Попробуй еще раз!"

       

    new_bal = get_balance(user_id)

    await callback.message.answer(

        f"{text}\nТекущий баланс: <b>{new_bal} ⭐</b>",

        reply_markup=main_keyboard(),

        parse_mode="HTML"

    )

 

@dp.callback_query(F.data == "play_dice")

async def play_dice(callback: types.CallbackQuery):

    user_id = callback.from_user.id

    bet = 10

    if get_balance(user_id) < bet:

        await callback.answer("Недостаточно звезд! Нажми «Купить звезды».", show_alert=True)

        return

 

    update_balance(user_id, -bet)

    await callback.answer()

    msg = await callback.message.answer_dice(emoji="🎲")

    val = msg.dice.value

    await asyncio.sleep(3)

   

    if val >= 4:

        win = bet * 2

        update_balance(user_id, win)

        text = f"🎲 Выпало {val}! Победа: <b>+{win} ⭐</b>!"

    else:

        text = f"🎲 Выпало {val}. Нужно 4 или больше."

       

    new_bal = get_balance(user_id)

    await callback.message.answer(

        f"{text}\nТекущий баланс: <b>{new_bal} ⭐</b>",

        reply_markup=main_keyboard(),

        parse_mode="HTML"

    )

 

@dp.callback_query(F.data == "play_hilo")

async def start_hilo(callback: types.CallbackQuery):

    user_id = callback.from_user.id

    bet = 10

    if get_balance(user_id) < bet:

        await callback.answer("Недостаточно звезд! Нажми «Купить звезды».", show_alert=True)

        return

 

    update_balance(user_id, -bet)

    first_number = random.randint(2, 99)

    active_games[user_id] = {"number": first_number, "bet": bet}

 

    await callback.message.edit_text(

        f"🔢 <b>Игра «Больше-меньше»</b>\n"

        f"Ставка: <b>{bet} ⭐</b>\n\n"

        f"Текущее число: <b>{first_number}</b> (от 1 до 100)\n"

        f"Каким будет следующее число?",

        reply_markup=get_hilo_keyboard(first_number),

        parse_mode="HTML"

    )

 

@dp.callback_query(F.data.startswith("hilo_"))

async def process_hilo(callback: types.CallbackQuery):

    user_id = callback.from_user.id

    if user_id not in active_games:

        await callback.answer("Игра уже завершена. Начни новую!", show_alert=True)

        return

 

    _, choice, mult_str = callback.data.split("_")

    mult = float(mult_str)

   

    game_data = active_games.pop(user_id)

    prev_num = game_data["number"]

    bet = game_data["bet"]

    next_num = random.randint(1, 100)

   

    is_win = (choice == "high" and next_num > prev_num) or (choice == "low" and next_num < prev_num)

 

    if is_win:

        win_amount = int(bet * mult)

        update_balance(user_id, win_amount)

        result_text = f"🎉 <b>Победа!</b> Выпало число <b>{next_num}</b>.\nВыигрыш: <b>+{win_amount} ⭐</b> (x{mult})"

    else:

        result_text = f"💥 <b>Проигрыш!</b> Выпало число <b>{next_num}</b>.\nСтавка {bet} ⭐ сгорела."

 

    new_bal = get_balance(user_id)

    again_kb = InlineKeyboardMarkup(inline_keyboard=(

        (InlineKeyboardButton(text="🔄 Сыграть еще (10 ⭐)", callback_data="play_hilo"),),

        (InlineKeyboardButton(text="🔙 В главное меню", callback_data="main_menu"),)

    ))

 

    await callback.message.edit_text(

        f"Было число: <b>{prev_num}</b> ➡️ Стало: <b>{next_num}</b>\n\n"

        f"{result_text}\n"

        f"Текущий баланс: <b>{new_bal} ⭐</b>",

        reply_markup=again_kb,

        parse_mode="HTML"

    )

 

async def main():

    init_db()

    print("Бот на Telegram Stars успешно запущен!")

    await dp.start_polling(bot)

 

if __name__ == "__main__":

    asyncio.run(main())

