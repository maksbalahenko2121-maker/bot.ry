import asyncio

import logging

import random

import sqlite3

from aiogram import Bot, Dispatcher, F, types

from aiogram.filters import Command

from aiogram.fsm.context import FSMContext

from aiogram.fsm.state import State, StatesGroup

from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton, LabeledPrice, PreCheckoutQuery

 

TOKEN = "9059209753:AAFaj8EcKY-I8dvfEqxswjWdyujylqHO4rA"

ADMIN_ID = 6921885296

 

logging.basicConfig(level=logging.INFO)

bot = Bot(token=TOKEN)

dp = Dispatcher()

 

active_games = {}

 

class AdminStates(StatesGroup):

    waiting_for_give_data = State()

    waiting_for_broadcast = State()

 

class UserStates(StatesGroup):

    waiting_for_withdraw_amount = State()

 

def init_db():

    conn = sqlite3.connect("casino_stars.db")

    cur = conn.cursor()

    cur.execute("""

        CREATE TABLE IF NOT EXISTS users (

            user_id INTEGER PRIMARY KEY,

            balance INTEGER DEFAULT 0

        )

    """)

    conn.commit()

    conn.close()

 

def get_balance(user_id: int) -> int:

    conn = sqlite3.connect("casino_stars.db")

    cur = conn.cursor()

    cur.execute("SELECT balance FROM users WHERE user_id = ?", (user_id,))

    res = cur.fetchone()

    if res is None:

        cur.execute("INSERT INTO users (user_id, balance) VALUES (?, 0)", (user_id,))

        conn.commit()

        balance = 0

    else:

        (balance,) = res

    conn.close()

    return balance

 

def update_balance(user_id: int, amount: int):

    conn = sqlite3.connect("casino_stars.db")

    cur = conn.cursor()

    cur.execute("SELECT balance FROM users WHERE user_id = ?", (user_id,))

    if cur.fetchone() is None:

        cur.execute("INSERT INTO users (user_id, balance) VALUES (?, ?)", (user_id, max(0, amount)))

    else:

        cur.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (amount, user_id))

    conn.commit()

    conn.close()

 

def get_stats():

    conn = sqlite3.connect("casino_stars.db")

    cur = conn.cursor()

    cur.execute("SELECT COUNT(*), SUM(balance) FROM users")

    users_count, total_stars = cur.fetchone()

    conn.close()

    return users_count or 0, total_stars or 0

 

def get_all_users():

    conn = sqlite3.connect("casino_stars.db")

    cur = conn.cursor()

    cur.execute("SELECT user_id FROM users")

    rows = cur.fetchall()

    conn.close()

    return tuple(uid for (uid,) in rows)

 

def main_keyboard():

    return InlineKeyboardMarkup(inline_keyboard=(

        (InlineKeyboardButton(text="🎰 Слоты (10 ⭐)", callback_data="play_slots"),),

        (InlineKeyboardButton(text="🎲 Кубик (10 ⭐)", callback_data="play_dice"),),

        (InlineKeyboardButton(text="🔢 Больше-меньше (10 ⭐)", callback_data="play_hilo"),),

        (

            InlineKeyboardButton(text="⭐ Купить звезды", callback_data="buy_stars_menu"),

            InlineKeyboardButton(text="📤 Вывести звезды", callback_data="withdraw_stars")

        )

    ))

 

