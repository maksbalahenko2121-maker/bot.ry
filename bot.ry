def cancel_keyboard(callback_target: str):

    return InlineKeyboardMarkup(inline_keyboard=(

        (InlineKeyboardButton(text="❌ Отмена", callback_data=callback_target),),

    ))

 

def get_hilo_keyboard(current_num: int):

    chance_low = (current_num - 1) / 100

    chance_high = (100 - current_num) / 100

    mult_low = round(0.95 / chance_low, 2) if chance_low > 0 else 0

    mult_high = round(0.95 / chance_high, 2) if chance_high > 0 else 0

 

    buttons = []

    if mult_high > 0:

        buttons.append(InlineKeyboardButton(text=f"📈 Больше (x{mult_high})", callback_data=f"hilo_high_{mult_high}"))

    if mult_low > 0:

        buttons.append(InlineKeyboardButton(text=f"📉 Меньше (x{mult_low})", callback_data=f"hilo_low_{mult_low}"))

       

    return InlineKeyboardMarkup(inline_keyboard=(

        tuple(buttons),

        (InlineKeyboardButton(text="🔙 В главное меню", callback_data="main_menu"),)

    ))

@dp.callback_query(F.data == "buy_stars_menu")

async def show_buy_menu(callback: types.CallbackQuery):

    await callback.message.edit_text(

        "⭐ <b>Пополнение игрового баланса</b>\n\n"

        "Выбери пакет звезд для покупки. После оплаты они моментально зачислятся на твой профиль:",

        reply_markup=buy_stars_keyboard(),

        parse_mode="HTML"

    )

 

@dp.callback_query(F.data.startswith("buy_"))

async def send_stars_invoice(callback: types.CallbackQuery):

    _, amount_str = callback.data.split("_")

    amount = int(amount_str)

    await callback.answer()

    await callback.message.answer_invoice(

        title=f"Пополнение на {amount} звезд",

        description=f"Зачисление {amount} ⭐ на игровой баланс профиля.",

        payload=f"stars_topup_{amount}",

        provider_token="",

        currency="XTR",

        prices=(LabeledPrice(label=f"{amount} звезд", amount=amount),)

    )

 

@dp.pre_checkout_query()

async def pre_checkout_handler(pre_checkout_query: PreCheckoutQuery):

    await pre_checkout_query.answer(ok=True)

 

@dp.message(F.successful_payment)

async def successful_payment_handler(message: types.Message):

    payload = message.successful_payment.invoice_payload

    if payload.startswith("stars_topup_"):

        _, _, amount_str = payload.split("_")

        amount = int(amount_str)

        update_balance(message.from_user.id, amount)

        new_bal = get_balance(message.from_user.id)

        await message.answer(

            f"✅ <b>Оплата прошла успешно!</b>\n"

            f"На твой профиль начислено: <b>+{amount} ⭐</b>\n"

            f"Текущий баланс: <b>{new_bal} ⭐</b>",

            reply_markup=main_keyboard(),

            parse_mode="HTML"

        )

 

@dp.callback_query(F.data == "withdraw_stars")

async def start_withdraw(callback: types.CallbackQuery, state: FSMContext):

    user = callback.from_user

    if not user.username:

        await callback.answer(

            "⚠️ У тебя не установлен @username в профиле Telegram! Установи его в настройках, чтобы мы могли отправить тебе звезды.",

            show_alert=True

        )

        return

 

    bal = get_balance(user.id)

    if bal < 10:

        await callback.answer("Минимальная сумма для вывода — 10 ⭐.", show_alert=True)

        return

 

    await state.set_state(UserStates.waiting_for_withdraw_amount)

    await callback.message.edit_text(

        f"📤 <b>Заявка на вывод звезд</b>\n\n"

        f"Твой баланс: <b>{bal} ⭐</b>\n"

        f"Получатель: @{user.username}\n\n"

        f"Введи количество звезд, которое хочешь вывести (минимум 10):",

        reply_markup=cancel_keyboard("main_menu"),

        parse_mode="HTML"

    )

 

@dp.message(UserStates.waiting_for_withdraw_amount)

async def process_withdraw(message: types.Message, state: FSMContext):

    user = message.from_user

    if not user.username:

        await state.clear()

        await message.answer("⚠️ Ошибка: у тебя пропал @username. Установи его в настройках Telegram и попробуй снова.")

        return

 

    try:

        amount = int(message.text.strip())

    except ValueError:

        await message.answer("⚠️ Введи целое число, например: <code>50</code>", parse_mode="HTML")

        return

 

    bal = get_balance(user.id)

    if amount < 10:

        await message.answer("⚠️ Минимальная сумма вывода — 10 ⭐. Введи другое число:")

        return

    if amount > bal:

        await message.answer(f"⚠️ Недостаточно средств. Твой баланс: <b>{bal} ⭐</b>. Введи сумму меньше:", parse_mode="HTML")

        return

 

    update_balance(user.id, -amount)

    await state.clear()

 

    admin_text = (

        f"🔔 <b>Новая заявка на вывод!</b>\n\n"

        f"👤 Игрок: @{user.username}\n"

        f"🆔 ID: <code>{user.id}</code>\n"

        f"💰 Сумма: <b>{amount} ⭐</b>"

    )

    try:

        await bot.send_message(ADMIN_ID, admin_text, parse_mode="HTML")

    except Exception:

        pass

 

    await message.answer(

        f"✅ <b>Заявка на вывод {amount} ⭐ создана!</b>\n"

        f"Ожидай отправки на аккаунт @{user.username}.\n"

        f"Остаток на балансе: <b>{get_balance(user.id)} ⭐</b>",

        reply_markup=main_keyboard(),

        parse_mode="HTML"

    )

 

