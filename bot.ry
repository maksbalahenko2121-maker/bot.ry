@dp.message(AdminStates.waiting_for_give_data)

async def admin_give_process(message: types.Message, state: FSMContext):

    if message.from_user.id != ADMIN_ID:

        return

    try:

        target_str, amount_str = message.text.split()

        target_id = int(target_str)

        amount = int(amount_str)

    except ValueError:

        await message.answer("⚠️ Неверный формат! Введи два числа через пробел, например: <code>987654321 50</code>", reply_markup=cancel_keyboard("admin_cancel"), parse_mode="HTML")

        return

 

    update_balance(target_id, amount)

    new_bal = get_balance(target_id)

    await state.clear()

    await message.answer(

        f"✅ Баланс игрока <code>{target_id}</code> изменен на <b>{amount} ⭐</b>.\nТекущий баланс игрока: <b>{new_bal} ⭐</b>.",

        reply_markup=admin_keyboard(),

        parse_mode="HTML"

    )

 

@dp.callback_query(F.data == "admin_broadcast")

async def admin_broadcast_start(callback: types.CallbackQuery, state: FSMContext):

    if callback.from_user.id != ADMIN_ID:

        return

    await state.set_state(AdminStates.waiting_for_broadcast)

    await callback.message.edit_text("📢 Отправь текст сообщения для рассылки всем игрокам:", reply_markup=cancel_keyboard("admin_cancel"))

 

@dp.message(AdminStates.waiting_for_broadcast)

async def admin_broadcast_process(message: types.Message, state: FSMContext):

    if message.from_user.id != ADMIN_ID:

        return

    users = get_all_users()

    sent = 0

    await state.clear()

    status_msg = await message.answer("⏳ Начинаю рассылку...")

   

    for uid in users:

        try:

            await bot.send_message(uid, f"📣 <b>Объявление:</b>\n\n{message.text}", parse_mode="HTML")

            sent += 1

            await asyncio.sleep(0.05)

        except Exception:

            pass

           

    await status_msg.edit_text(

        f"✅ Рассылка завершена!\nДоставлено: <b>{sent} из {len(users)}</b> игрокам.",

        reply_markup=admin_keyboard(),

        parse_mode="HTML"

    )

